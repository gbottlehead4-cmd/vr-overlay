<Page
  x:Class="VisorVRApp.TabPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:VisorVRApp"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Background="Transparent"
  Foreground="{ThemeResource TextFillColorPrimary}">
  <Page.Resources>
    <local:BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    <local:MetersValueConverter x:Key="MetersConverter"/>
    <!--
      Panel-type-specific settings. These are appended to the common inline
      settings below, so that everything for a panel is in one place and there
      is no separate settings page to navigate to.
    -->
    <DataTemplate x:Key="GenericPanelExtras" x:DataType="local:TabUIData">
      <StackPanel/>
    </DataTemplate>
    <DataTemplate
      x:Key="BrowserPanelExtras"
      x:DataType="local:BrowserTabUIData">
      <Border
        Background="#FF1B1D24"
        BorderBrush="#18FFFFFF"
        BorderThickness="1"
        CornerRadius="12"
        Padding="16">
        <StackPanel Spacing="12" x:DefaultBindMode="TwoWay">
          <TextBlock
            Text="WEB PANEL"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"/>
          <StackPanel Spacing="6">
            <TextBlock Text="Sharpness"/>
            <Slider
              Minimum="100"
              Maximum="{x:Bind MaxRenderScalePercent, Mode=OneWay}"
              StepFrequency="25"
              TickFrequency="25"
              TickPlacement="Outside"
              Value="{x:Bind RenderScalePercent}"/>
            <TextBlock
              Text="{x:Bind RenderResolutionDescription, Mode=OneWay}"
              FontSize="12"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock
              Text="Higher stays crisp when the panel is close, and costs more GPU. The page layout does not change."
              FontSize="12"
              TextWrapping="Wrap"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
          <ToggleSwitch
            IsOn="{x:Bind IsBackgroundTransparent}"
            Header="Transparent background"
            OffContent="Background is solid"
            OnContent="Background is transparent"/>
          <ToggleSwitch
            IsOn="{x:Bind AreOpenKneeboardAPIsEnabled}"
            Header="Allow web pages to integrate with VisorVR"/>
          <ToggleSwitch
            IsOn="{x:Bind IsSimHubIntegrationEnabled}"
            IsEnabled="{x:Bind AreOpenKneeboardAPIsEnabled}"
            Header="SimHub integration"
            OffContent="Disabled"
            OnContent="Automatically resize to fit SimHub dashboards"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate
      x:Key="DCSRadioLogPanelExtras"
      x:DataType="local:DCSRadioLogTabUIData">
      <Border
        Background="#FF1B1D24"
        BorderBrush="#18FFFFFF"
        BorderThickness="1"
        CornerRadius="12"
        Padding="16">
        <StackPanel Spacing="12" x:DefaultBindMode="TwoWay">
          <TextBlock
            Text="RADIO LOG"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"/>
          <RadioButtons
            SelectedIndex="{x:Bind MissionStartBehavior}"
            MaxColumns="2"
            Header="On mission start">
            <x:String>Draw a separator</x:String>
            <x:String>Clear history</x:String>
          </RadioButtons>
          <ToggleSwitch
            IsOn="{x:Bind TimestampsEnabled}"
            Header="Timestamps"
            OffContent="No Timestamps"
            OnContent="Show Timestamps"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate
      x:Key="WindowCapturePanelExtras"
      x:DataType="local:WindowCaptureTabUIData">
      <Border
        Background="#FF1B1D24"
        BorderBrush="#18FFFFFF"
        BorderThickness="1"
        CornerRadius="12"
        Padding="16">
        <StackPanel Spacing="12" x:DefaultBindMode="TwoWay">
          <TextBlock
            Text="WINDOW CAPTURE"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"/>
          <TextBox
            Header="Executable path"
            Text="{x:Bind ExecutablePathPattern}"
            PlaceholderText="Executable path pattern"/>
          <TextBlock
            FontSize="12"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="The full path to the executable; MS-DOS wildcards such as '*' are supported."/>
          <ToggleSwitch
            Header="Capture client area"
            IsOn="{x:Bind CaptureClientArea}"
            OnContent="Crop classic window borders, title bars, and menu bars"
            OffContent="The entire window is captured"/>
          <ComboBox
            Header="Match window title"
            SelectedIndex="{x:Bind MatchWindowTitle}">
            <x:String>Do not match</x:String>
            <x:String>Match exactly</x:String>
            <x:String>Match with pattern (use '*' and '?')</x:String>
          </ComboBox>
          <TextBox
            Header="Window title"
            Text="{x:Bind WindowTitle}"
            PlaceholderText="Window title"/>
          <ToggleSwitch
            Header="Match window class"
            IsOn="{x:Bind MatchWindowClass}"
            OnContent="Enabled"
            OffContent="Disabled"/>
          <TextBox
            Header="Window class"
            Text="{x:Bind WindowClass}"
            IsEnabled="False"/>
          <ToggleSwitch
            Header="Show Windows mouse cursor"
            IsOn="{x:Bind IsCursorCaptureEnabled}"
            OnContent="The real mouse cursor is visible in the panel"
            OffContent="The real mouse cursor is not visible in the panel"/>
          <ToggleSwitch
            Header="Use graphics tablet as mouse"
            IsOn="{x:Bind IsInputEnabled}"
            OnContent="Enabled"
            OffContent="Disabled"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <local:TabUIDataTemplateSelector
      x:Name="PanelExtrasTemplateSelector"
      Generic="{StaticResource GenericPanelExtras}"
      Browser="{StaticResource BrowserPanelExtras}"
      DCSRadioLog="{StaticResource DCSRadioLogPanelExtras}"
      WindowCapture="{StaticResource WindowCapturePanelExtras}"/>
    <DataTemplate
      x:Key="InlineTabSettingsTemplate"
      x:DataType="local:TabUIData">
      <StackPanel
        Orientation="Vertical"
        Spacing="16"
        x:DefaultBindMode="TwoWay">
        <StackPanel Spacing="6">
          <TextBlock
            Text="Panel name"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"/>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{x:Bind Title,Mode=TwoWay}"/>
            <ComboBox
              Grid.Column="1"
              MinWidth="72"
              ToolTipService.ToolTip="Panel icon"
              SelectedIndex="{x:Bind IconIndex,Mode=TwoWay}">
              <ComboBoxItem>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                  <TextBlock Text="Auto"/>
                </StackPanel>
              </ComboBoxItem>
              <ComboBoxItem><FontIcon Glyph="&#xEB41;" FontSize="16"/></ComboBoxItem>
              <ComboBoxItem><FontIcon Glyph="&#xE7F4;" FontSize="16"/></ComboBoxItem>
              <ComboBoxItem><FontIcon Glyph="&#xE909;" FontSize="16"/></ComboBoxItem>
              <ComboBoxItem><FontIcon Glyph="&#xF12E;" FontSize="16"/></ComboBoxItem>
              <ComboBoxItem><FontIcon Glyph="&#xE95D;" FontSize="16"/></ComboBoxItem>
              <ComboBoxItem><FontIcon Glyph="&#xE709;" FontSize="16"/></ComboBoxItem>
              <ComboBoxItem><FontIcon Glyph="&#xF0E3;" FontSize="16"/></ComboBoxItem>
              <ComboBoxItem><FontIcon Glyph="&#xE838;" FontSize="16"/></ComboBoxItem>
              <ComboBoxItem><FontIcon Glyph="&#xEA90;" FontSize="16"/></ComboBoxItem>
              <ComboBoxItem><FontIcon Glyph="&#xE8ED;" FontSize="16"/></ComboBoxItem>
              <ComboBoxItem><FontIcon Glyph="&#xE713;" FontSize="16"/></ComboBoxItem>
            </ComboBox>
          </Grid>
        </StackPanel>
        <Border
          Visibility="{x:Bind HasVRPlacement, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}"
          Background="#FF1B1D24"
          BorderBrush="#18FFFFFF"
          BorderThickness="1"
          CornerRadius="12"
          Padding="16">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon
                Glyph="&#xE809;"
                FontSize="14"
                Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
              <TextBlock
                Text="PLACEMENT IN VR"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"/>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Show this panel in VR" VerticalAlignment="Center"/>
              <ToggleSwitch
                Grid.Column="1"
                IsOn="{x:Bind IsVREnabled}"
                MinWidth="0"
                OnContent=""
                OffContent=""
                HorizontalAlignment="Right"/>
            </Grid>
            <StackPanel Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                  Text="Size"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock
                  Grid.Column="1"
                  Text="{Binding Value, ElementName=InlineSizeSlider, Converter={StaticResource MetersConverter}}"/>
              </Grid>
              <Slider
                x:Name="InlineSizeSlider"
                Minimum="0.05"
                Maximum="1.5"
                StepFrequency="0.01"
                Value="{x:Bind VRWidth}"
                ThumbToolTipValueConverter="{StaticResource MetersConverter}"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                  Text="Distance"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock
                  Grid.Column="1"
                  Text="{Binding Value, ElementName=InlineDistanceSlider, Converter={StaticResource MetersConverter}}"/>
              </Grid>
              <Slider
                x:Name="InlineDistanceSlider"
                Minimum="0.2"
                Maximum="3.0"
                StepFrequency="0.05"
                Value="{x:Bind VRDistance}"
                ThumbToolTipValueConverter="{StaticResource MetersConverter}"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border
          Visibility="{x:Bind HasVRPlacement, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}"
          Background="#FF1B1D24"
          BorderBrush="#18FFFFFF"
          BorderThickness="1"
          CornerRadius="12"
          Padding="12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border
              Grid.Column="0"
              Width="36"
              Height="36"
              CornerRadius="8"
              VerticalAlignment="Center"
              Background="{ThemeResource AccentFillColorTertiaryBrush}">
              <PathIcon
                Foreground="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M2,5 L14,5 A2,2 0 0 1 16,7 L16,10 A2,2 0 0 1 14,12 L10.5,12 L8,9.6 L5.5,12 L2,12 A2,2 0 0 1 0,10 L0,7 A2,2 0 0 1 2,5 Z"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
              <TextBlock Text="Position &amp; tilt"/>
              <TextBlock
                Text="Grab and place it with your mouse, in the headset."
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel
              Grid.Column="2"
              Orientation="Horizontal"
              Spacing="8"
              VerticalAlignment="Center">
              <Button Content="Recenter" Click="RecenterVR"/>
              <Button
                Content="Edit in VR"
                Click="ToggleVREditMode"
                Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel
          Spacing="6"
          Visibility="{x:Bind HasVRPlacement, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
          <HyperlinkButton
            Click="GoToInputBindings"
            Padding="0"
            Content="Set up controller buttons"/>
          <TextBlock
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="Tip: bind Toggle VR edit mode, Recenter and Show/hide to your wheel or HOTAS for hands-free access in VR."/>
        </StackPanel>
        <ContentControl
          HorizontalContentAlignment="Stretch"
          Content="{x:Bind Mode=OneTime}"
          ContentTemplateSelector="{StaticResource PanelExtrasTemplateSelector}"/>
      </StackPanel>
    </DataTemplate>
  </Page.Resources>
  <Grid RowDefinitions="Auto,Auto,*">
    <CommandBar
      x:Name="CommandBar"
      Grid.Row="0" />

    <Grid
      Grid.Row="1"
      Margin="20,2,20,10"
      ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <FontIcon
        x:Name="PanelIcon"
        Grid.Column="0"
        FontSize="18"
        VerticalAlignment="Center"
        Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
      <StackPanel
        Grid.Column="1"
        Orientation="Horizontal"
        Spacing="10"
        VerticalAlignment="Center">
        <TextBlock
          x:Name="PanelTitle"
          Style="{StaticResource SubtitleTextBlockStyle}"
          VerticalAlignment="Center"/>
        <Border
          x:Name="LivePill"
          Visibility="Collapsed"
          VerticalAlignment="Center"
          CornerRadius="10"
          Padding="8,2"
          Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
          <TextBlock
            Text="live"
            FontSize="11"
            Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
        </Border>
      </StackPanel>
      <Border
        Grid.Column="2"
        CornerRadius="9"
        Padding="3"
        Background="#FF1B1D24">
        <StackPanel Orientation="Horizontal" Spacing="3">
          <Button
            x:Name="PreviewButton"
            Content="Preview"
            Click="ShowPreview"/>
          <Button
            x:Name="SettingsButton"
            Content="Settings"
            Click="ShowPanelSettings"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <SwapChainPanel
        x:Name="Canvas"
        Margin="12"
        SizeChanged="OnCanvasSizeChanged"
      />
      <ScrollViewer
        x:Name="SettingsOverlay"
        Visibility="Collapsed"
        Background="#FF15161C"
        Padding="20,4,20,24"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <ContentControl
          x:Name="SettingsContent"
          HorizontalAlignment="Left"
          HorizontalContentAlignment="Stretch"
          MaxWidth="520"
          ContentTemplate="{StaticResource InlineTabSettingsTemplate}"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
