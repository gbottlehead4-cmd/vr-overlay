<Application
  x:Class="VisorVRApp.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:VisorVRApp">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <!-- VisorVR brand accent: a soft indigo, used sparingly on
             selection / toggles / sliders / primary actions. -->
        <ResourceDictionary x:Key="Default">
          <!-- VisorVR dark shell: deep blue-black instead of Windows grey. -->
          <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF1A1C23"/>
          <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF1A1C23"/>
          <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
          <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF15161C"/>
          <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF15161C"/>
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF1B1D24"/>
          <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF20222B"/>
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#18FFFFFF"/>
          <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF20222B"/>
          <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF262933"/>
          <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF2A2D38"/>
          <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF0F1013"/>
          <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF262933"/>
          <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF20222B"/>
          <SolidColorBrush x:Key="ContentDialogBackground" Color="#FF1B1D24"/>
          <!-- Chunkier sliders with a white thumb, as in the design. -->
          <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
          <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF"/>
          <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF"/>
          <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFFFF"/>
          <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF7C83FF"/>
          <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF8F95FF"/>
          <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF8F95FF"/>
          <SolidColorBrush x:Key="SliderTrackFill" Color="#FF2A2D38"/>
          <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#FF32353F"/>
          <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#FF32353F"/>
          <Color x:Key="SystemAccentColor">#FF7C83FF</Color>
          <Color x:Key="SystemAccentColorLight1">#FF8F95FF</Color>
          <Color x:Key="SystemAccentColorLight2">#FFA3A8FF</Color>
          <Color x:Key="SystemAccentColorLight3">#FFB8BCFF</Color>
          <Color x:Key="SystemAccentColorDark1">#FF6970E6</Color>
          <Color x:Key="SystemAccentColorDark2">#FF565CBF</Color>
          <Color x:Key="SystemAccentColorDark3">#FF434899</Color>
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF7C83FF" />
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF8F95FF" />
          <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF6970E6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#FF5A61E6</Color>
          <Color x:Key="SystemAccentColorLight1">#FF7C83FF</Color>
          <Color x:Key="SystemAccentColorLight2">#FF8F95FF</Color>
          <Color x:Key="SystemAccentColorLight3">#FFA3A8FF</Color>
          <Color x:Key="SystemAccentColorDark1">#FF4A50BF</Color>
          <Color x:Key="SystemAccentColorDark2">#FF3B4099</Color>
          <Color x:Key="SystemAccentColorDark3">#FF2C3073</Color>
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF5A61E6" />
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF4A50BF" />
          <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF3B4099" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="WindowCaptionBackground" Color="Transparent" />
      <SolidColorBrush x:Key="WindowCaptionBackgroundDisabled" Color="Transparent" />
      <!-- Softer, rounded edges everywhere (default WinUI is 4). -->
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    </ResourceDictionary>
  </Application.Resources>
</Application>
