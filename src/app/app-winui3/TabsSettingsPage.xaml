<Page
  x:Class="VisorVRApp.TabsSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:VisorVRApp"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Background="Transparent">
  <Page.Resources>
    <local:BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    <local:MetersValueConverter x:Key="MetersConverter"/>
    <DataTemplate
      x:Key="TabListEntry"
      x:DataType="local:TabUIData">
      <Grid
        ColumnDefinitions="Auto,*,Auto,Auto"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        CornerRadius="8"
        Margin="4"
        Padding="8"
        x:DefaultBindMode="TwoWay">
        <Button
          Grid.Column="0"
          Tag="{x:Bind InstanceID,Mode=OneTime}"
          ToolTipService.ToolTip="Panel settings"
          Margin="0,0,8,0"
          Click="ShowTabSettings">
          <FontIcon Glyph="&#xe713;"/>
        </Button>
        <TextBlock
          Grid.Column="1"
          Style="{StaticResource BodyStrongTextBlockStyle}"
          Text="{x:Bind Title,Mode=OneWay}"
          VerticalAlignment="Center"/>
        <Button
          Grid.Column="2"
          Tag="{x:Bind InstanceID,Mode=OneTime}"
          ToolTipService.ToolTip="Show troubleshooting information"
          Margin="0,0,8,0"
          Visibility="{x:Bind HasDebugInformation, Converter={StaticResource BooleanToVisibility},Mode=OneWay}"
          Click="ShowDebugInfo">
          <FontIcon Glyph="&#xEbE8;"/>
        </Button>
        <Button Grid.Column="3"
                Tag="{x:Bind InstanceID,Mode=OneTime}"
                Click="RemoveTab">
          <SymbolIcon Symbol="Delete"/>
        </Button>
      </Grid>
    </DataTemplate>
    <!--- Common for all tabs -->
    <DataTemplate
      x:Key="TabSettingsCommon"
      x:DataType="local:TabUIData">
      <StackPanel
        Orientation="Vertical"
        Spacing="8">
        <TextBox
          Text="{x:Bind Title,Mode=TwoWay}"
          Header="Panel name"/>
        <StackPanel
          Orientation="Vertical"
          Spacing="12"
          x:DefaultBindMode="TwoWay"
          Visibility="{x:Bind HasVRPlacement, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock
            Text="PLACEMENT IN VR"
            Margin="0,10,0,-2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"/>
          <ToggleSwitch
            IsOn="{x:Bind IsVREnabled}"
            Header="Show this panel in VR"
            OffContent="Hidden"
            OnContent="Shown"/>
          <StackPanel Spacing="2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock
                Text="Width"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock
                Grid.Column="1"
                Text="{Binding Value, ElementName=VRWidthSlider, Converter={StaticResource MetersConverter}}"/>
            </Grid>
            <Slider
              x:Name="VRWidthSlider"
              Minimum="0.05"
              Maximum="1.5"
              StepFrequency="0.01"
              Value="{x:Bind VRWidth}"
              ThumbToolTipValueConverter="{StaticResource MetersConverter}"/>
          </StackPanel>
          <StackPanel Spacing="2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock
                Text="Height"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock
                Grid.Column="1"
                Text="{Binding Value, ElementName=VRHeightSlider, Converter={StaticResource MetersConverter}}"/>
            </Grid>
            <Slider
              x:Name="VRHeightSlider"
              Minimum="0.05"
              Maximum="1.0"
              StepFrequency="0.01"
              Value="{x:Bind VRHeight}"
              ThumbToolTipValueConverter="{StaticResource MetersConverter}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
            <Button
              Click="ToggleVREditMode"
              Style="{StaticResource AccentButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                <TextBlock Text="Edit in VR"/>
              </StackPanel>
            </Button>
            <Button Click="RecenterVR" Content="Recenter"/>
          </StackPanel>
          <TextBlock
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="In the headset: grab to move, scroll to resize or change distance, Shift + move to tilt. Position, size, distance and tilt are all adjustable in VR."/>
          <HyperlinkButton
            Click="GoToInputBindings"
            Margin="0,-4,0,0"
            Padding="0"
            Content="Set up controller buttons"/>
          <TextBlock
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="Tip: bind Toggle VR edit mode, Recenter and Show/hide to your wheel or HOTAS for hands-free access in VR."/>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <!-- Any Tab -->
    <DataTemplate
      x:Key="GenericTabTemplate"
      x:DataType="local:TabUIData">
      <StackPanel
        Orientation="Vertical"
        Spacing="8"
        x:DefaultBindMode="TwoWay">
        <ContentPresenter
          Content="{x:Bind Mode=OneTime}"
          ContentTemplate="{StaticResource TabSettingsCommon}"/>
      </StackPanel>
    </DataTemplate>
    <!-- Browser Tab -->
    <DataTemplate
      x:Key="BrowserTabTemplate"
      x:DataType="local:BrowserTabUIData">
      <StackPanel
        Orientation="Vertical"
        Spacing="8"
        x:DefaultBindMode="TwoWay">
        <ContentPresenter
          Content="{x:Bind Mode=OneTime}"
          ContentTemplate="{StaticResource TabSettingsCommon}"/>
        <ToggleSwitch
          IsOn="{x:Bind IsBackgroundTransparent}"
          Header="Transparent background"
          OffContent="Background is solid"
          OnContent="Background is transparent"/>
        <ToggleSwitch
          IsOn="{x:Bind AreOpenKneeboardAPIsEnabled}"
          Header="Allow web pages to integrate with VisorVR" />
        <ToggleSwitch
          IsOn="{x:Bind IsSimHubIntegrationEnabled}"
          IsEnabled="{x:Bind AreOpenKneeboardAPIsEnabled}"
          Header="SimHub integration"
          OffContent="Disabled"
          OnContent="Automatically resize to fit SimHub dashboards"/>
        <StackPanel Orientation="Vertical">
          <Slider
            Header="Sharpness"
            Minimum="100"
            Maximum="{x:Bind MaxRenderScalePercent, Mode=OneWay}"
            StepFrequency="25"
            TickFrequency="25"
            TickPlacement="Outside"
            Value="{x:Bind RenderScalePercent}"/>
          <TextBlock
            Text="{x:Bind RenderResolutionDescription, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Opacity="0.7"/>
          <TextBlock
            Text="Higher is sharper when the panel is close, and costs more GPU. The page layout does not change."
            TextWrapping="WrapWholeWords"
            Style="{StaticResource CaptionTextBlockStyle}"
            Opacity="0.7"/>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <!-- DCS Radio Tab -->
    <DataTemplate
      x:Key="DCSRadioLogTabTemplate"
      x:DataType="local:DCSRadioLogTabUIData">
      <StackPanel
        Orientation="Vertical"
        Spacing="8"
        x:DefaultBindMode="TwoWay">
        <ContentPresenter
          Content="{x:Bind Mode=OneTime}"
          ContentTemplate="{StaticResource TabSettingsCommon}"/>
        <RadioButtons
          SelectedIndex="{x:Bind MissionStartBehavior}"
          MaxColumns="2"
          Header="On mission start">
          <x:String>Draw a separator</x:String>
          <x:String>Clear history</x:String>
        </RadioButtons>
        <ToggleSwitch
          IsOn="{x:Bind TimestampsEnabled}"
          Header="Timestamps"
          OffContent="No Timestamps"
          OnContent="Show Timestamps"/>
      </StackPanel>
    </DataTemplate>
    <!-- Window Capture Tab -->
    <DataTemplate
      x:Key="WindowCaptureTabTemplate"
      x:DataType="local:WindowCaptureTabUIData">
      <StackPanel
        Orientation="Vertical"
        Spacing="8"
        x:DefaultBindMode="TwoWay">
        <ContentPresenter
          Content="{x:Bind Mode=OneTime}"
          ContentTemplate="{StaticResource TabSettingsCommon}"/>
        <TextBox
          Header="Executable path"
          Text="{x:Bind ExecutablePathPattern}"
          PlaceholderText="Executable path pattern"/>
        <TextBlock
          Style="{ThemeResource CaptionTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondary}">
          The full path to the executable; MS-DOS wildcards such as '*' are supported.
        </TextBlock>
        <ToggleSwitch
          Header="Capture client area"
          IsOn="{x:Bind CaptureClientArea}"
          OnContent="Crop classic window borders, title bars, and menu bars"
          OffContent="The entire window is captured"/>
        <TextBlock
          Style="{ThemeResource CaptionTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondary}">
          The 'client area' is the content of the window, excluding borders,
          title bars, and so on. This option will not remove title bars
          from windows that simulate a title bar, which includes most
          modern apps.
        </TextBlock>
        <ToggleSwitch
          Header="Use graphics tablet as mouse"
          IsOn="{x:Bind IsInputEnabled}"
          OnContent="Enabled"
          OffContent="Disabled"/>
        <ComboBox
          Header="Match window title"
          SelectedIndex="{x:Bind MatchWindowTitle}">
          <x:String>Do not match</x:String>
          <x:String>Match exactly</x:String>
          <x:String>Match with pattern (use '*' and '?')</x:String>
        </ComboBox>
        <TextBox
          Header="Window title"
          Text="{x:Bind WindowTitle}"
          PlaceholderText="Window title"/>
        <ToggleSwitch
          Header="Match window class"
          IsOn="{x:Bind MatchWindowClass}"
          OnContent="Enabled"
          OffContent="Disabled"/>
        <TextBox
          Header="Window class"
          Text="{x:Bind WindowClass}"
          IsEnabled="False"/>
        <TextBlock
          Style="{ThemeResource CaptionTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondary}">
          The class is meant to uniquely identify the 'kind' of window, for
          example it might be "MyApp's Main Window" or "MyApp's About
          Dialog". If this option is on, windows will only be captured if
          their window class is the same as when the panel was added.
        </TextBlock>
        <TextBlock
          Style="{ThemeResource CaptionTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondary}">
          Some applications - especially those built with the Universal
          Windows Platform (UWP) - do not use window classes correctly,
          so this option may need to be disabled if the window is not
          matched when the app is restarted.
        </TextBlock>
        <TextBlock
          Style="{ThemeResource CaptionTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondary}">
          This option is disabled by default for UWP apps, and enabled by
          default for all other apps.
        </TextBlock>
        <ToggleSwitch
          Header="Show Windows mouse cursor"
          IsOn="{x:Bind IsCursorCaptureEnabled}"
          OnContent="The real mouse cursor is visible in the panel"
          OffContent="The real mouse cursor is not visible in the panel"/>
        <TextBlock
          Style="{ThemeResource CaptionTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondary}">
          This controls whether the real Windows mouse cursor is visible
          in the panel; it does not affect which windows the mouse controls,
          and it does not affect VisorVR's cursor.
        </TextBlock>
        <TextBlock
          Style="{ThemeResource CaptionTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondary}">
          Because the game is usually on top of captured Windows and the
          game gets all real mouse input, this option is only useful for
          niche cases.
        </TextBlock>
      </StackPanel>
    </DataTemplate>
    <local:TabUIDataTemplateSelector
      x:Name="TabSettingsTemplateSelector"
      Generic="{StaticResource GenericTabTemplate}"
      Browser="{StaticResource BrowserTabTemplate}"
      DCSRadioLog="{StaticResource DCSRadioLogTabTemplate}"
      WindowCapture="{StaticResource WindowCaptureTabTemplate}"/>
  </Page.Resources>
  <!-- PAGE CONTENT STARTS HERE -->
  <ScrollViewer VerticalScrollMode="Auto"
                Padding="24">
    <StackPanel Margin="0,0,0,16">
      <Grid
        ColumnDefinitions="*,Auto,Auto"
        Margin="0,0,0,8">
        <TextBlock
          Grid.Column="0"
          Style="{StaticResource TitleTextBlockStyle}"
          Text="Panels"
          Margin="0,0,0,8"/>
        <Button
          Grid.Column="1"
          Margin="0,0,8,0"
          HorizontalAlignment="Center"
          Style="{StaticResource AccentButtonStyle}"
          x:Name="AddTabTopButton">
          <Grid ColumnDefinitions="Auto,*">
            <FontIcon
              Grid.Column="0"
              Glyph="&#xE710;"
              FontFamily="{StaticResource SymbolThemeFontFamily}"/>
            <TextBlock
              Margin="4,0,0,0"
              Grid.Column="1">
              Add panel
            </TextBlock>
          </Grid>
        </Button>
        <Button
          Grid.Column="2"
          Content="Restore defaults"
          Click="RestoreDefaults"/>
      </Grid>
      <ListView
        Grid.Row="1"
        ItemsSource="{x:Bind Tabs, Mode=OneWay}"
        x:Name="List"
        SelectionMode="None"
        CanDragItems="True"
        CanReorderItems="True"
        AllowDrop="True"
        ItemTemplate="{StaticResource TabListEntry}"/>
      <Button
        Margin="0,24,0,0"
        HorizontalAlignment="Center"
        Style="{StaticResource AccentButtonStyle}"
        x:Name="AddTabBottomButton">
        <Grid ColumnDefinitions="Auto,*">
          <FontIcon
            Grid.Column="0"
            Glyph="&#xE710;"
            FontFamily="{StaticResource SymbolThemeFontFamily}"/>
          <TextBlock
            Margin="8,4,4,4"
            Grid.Column="1">
            Add panel
          </TextBlock>
        </Grid>
      </Button>
      <ContentDialog
        x:Name="AddBrowserDialog"
        Title="Add a web panel"
        DefaultButton="Primary"
        PrimaryButtonText="Add panel"
        CloseButtonText="Cancel"
        IsPrimaryButtonEnabled="False">
        <StackPanel
          Orientation="Vertical"
          Spacing="20">
          <TextBlock Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap">
            A web panel displays a single page - it is not a general-purpose
            web browser. For a less limited browser, use your normal browser
            with a Window Capture panel.
          </TextBlock>
          <TextBlock
            Style="{ThemeResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap">
            Adding a SimHub dashboard? In SimHub: Dash Studio → Overlays →
            select the overlay → MORE → "Copy OBS browser address to clipboard",
            then paste it here. Help has the full steps.
          </TextBlock>
          <TextBox
            x:Name="AddBrowserAddress"
            Header="Address:"
            PlaceholderText="https://example.com"
            TextChanged="OnAddBrowserAddressTextChanged"/>
        </StackPanel>
      </ContentDialog>
      <ContentDialog
        x:Name="DebugInfoDialog"
        CloseButtonText="Close"
        DefaultButton="Close">
        <StackPanel
          Orientation="Vertical"
          Spacing="20">
          <TextBlock
            x:Name="DebugInfoText"
            IsTextSelectionEnabled="true"
            Style="{ThemeResource BodyTextBlockStyle}"/>
          <HyperlinkButton
            x:Name="CopyDebugInfoButton"
            HorizontalContentAlignment="Center"
            Click="CopyDebugInfo">
            <Grid ColumnDefinitions="*,Auto">
              <FontIcon
                Grid.Column="0"
                Glyph="&#xe8c8;"
                FontFamily="{StaticResource SymbolThemeFontFamily}"/>
              <TextBlock
                Margin="8,4,4,4"
                Grid.Column="1">Copy to clipboard</TextBlock>
            </Grid>
          </HyperlinkButton>
        </StackPanel>
      </ContentDialog>
      <ContentDialog
        x:Name="TabSettingsDialog"
        Title="Panel settings"
        CloseButtonText="Close"
        DefaultButton="Close">
        <ScrollViewer VerticalScrollMode="Auto"
                      Padding="24">
          <ContentPresenter
            x:Name="TabSettingsDialogContent"/>
        </ScrollViewer>
      </ContentDialog>
    </StackPanel>
  </ScrollViewer>
</Page>
