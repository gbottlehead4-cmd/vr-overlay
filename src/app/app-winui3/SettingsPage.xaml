<Page
  x:Class="VisorVRApp.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:VisorVRApp"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Background="Transparent">
  <ScrollViewer VerticalScrollMode="Auto">
    <StackPanel Margin="16">
      <TextBlock
        Style="{StaticResource TitleTextBlockStyle}"
        Text="Settings"
        Margin="0,0,0,8"/>
      <GridView
        x:Name="Grid"
        Grid.Row="1"
        IsItemClickEnabled="True"
        ItemClick="OnItemClick">
        <GridView.ItemTemplate>
          <DataTemplate x:Key="SettingsSubpageTemplate"
                        x:DataType="local:SettingsSubpageData">
            <Grid
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              CornerRadius="12"
              BorderThickness="1"
              ColumnDefinitions="Auto,*"
              Padding="12"
              Height="96"
              Width="360">
              <Grid
                Grid.Column="0"
                Width="72"
                Height="72"
                CornerRadius="12"
                Background="#FF232733">
                <FontIcon
                  Glyph="{x:Bind Glyph}"
                  FontSize="34"
                  Foreground="#FF9AA0FF"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"/>
              </Grid>
              <Grid RowDefinitions="Auto,*"
                    Grid.Column="1"
                    Margin="8,0,0,0">
                <TextBlock
                  Grid.Row="0"
                  Text="{x:Bind Title}"
                  Style="{StaticResource BodyStrongTextBlockStyle}"
                  TextWrapping="NoWrap"/>
                <TextBlock
                  Margin="8,0,0,0"
                  Grid.Row="1"
                  Text="{x:Bind Description}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  VerticalAlignment="Stretch"/>
              </Grid>
            </Grid>
          </DataTemplate>
        </GridView.ItemTemplate>
        <GridView.Items>
          <!-- Glyph reference: https://docs.microsoft.com/en-us/windows/apps/design/style/segoe-ui-symbol-font -->
          <!-- F119 HMD -->
          <local:SettingsSubpageData
            x:Name="VRItem"
            Glyph="&#xF119;"
            Title="Virtual Reality">
            Choose how your panels appear in-game, and set up SteamVR and OpenXR.
          </local:SettingsSubpageData>
          <!-- E7F4 window -->
          <local:SettingsSubpageData
            x:Name="TabsItem"
            Glyph="&#xE7F4;"
            Title="Panels">
            Add, remove, rename and re-order the panels you see in VR.
          </local:SettingsSubpageData>
          <!-- E961 Input -->
          <local:SettingsSubpageData
            x:Name="InputItem"
            Glyph="&#xE961;"
            Title="Input">
            Bind your wheel, HOTAS, keyboard or tablet buttons to VisorVR actions.
          </local:SettingsSubpageData>
          <!-- E9E9 Equalizer-->
          <local:SettingsSubpageData
            x:Name="AdvancedItem"
            Glyph="&#xE9E9;"
            Title="Advanced">
            Advanced features and behaviour tweaks.
          </local:SettingsSubpageData>
        </GridView.Items>
      </GridView>
    </StackPanel>
  </ScrollViewer>
</Page>
