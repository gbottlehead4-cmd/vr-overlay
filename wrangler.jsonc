{
  // VisorVR's landing page, deployed as a Worker with static assets.
  //
  // Cloudflare retired Pages project creation, so this replaces what would
  // have been a Pages project: `site/` is served as static assets, and
  // worker/index.js handles the single dynamic route, /api/hits.
  //
  // The name decides the URL: visorvr.gbottlehead4.workers.dev. The site
  // hardcodes that in its canonical link, og:url, sitemap and robots.txt, so
  // renaming this means updating those four places too.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visorvr",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "site",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      // The `visorvr-site-counter` namespace. A namespace id is not a secret -
      // it names a store that only this account's Workers can bind to.
      "binding": "COUNTER",
      "id": "aa5ac9cf6974429a8dc1f310c3a2e43f"
    }
  ],
  "observability": {
    "enabled": true
  }
}
